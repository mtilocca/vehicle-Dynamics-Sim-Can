/*
 * app.overlay — DeviceTree overlay for Nucleo-H753ZI
 *
 * Phase 0: USART3 only (ST-Link VCP, no extra cable needed).
 * Phase 1: uncomment FDCAN1 block.
 *
 * FDCAN1 wiring (when enabled):
 *   PD0 (RX) = CN11 morpho pin 57  — marked CAN on board silkscreen
 *   PD1 (TX) = CN11 morpho pin 55
 *   Connect to SN65HVD230 or TCAN1042 transceiver (3.3V compatible).
 */

/ {
    chosen {
        zephyr,console    = &usart3;
        zephyr,shell-uart = &usart3;
        zephyr,canbus     = &fdcan1;
    };

    /* LD3 (red, PB14) — board DTS exposes this only as a PWM LED.
     * Add it here as a plain GPIO so led_task.cpp can drive it directly. */
    app_leds: app_leds {
        compatible = "gpio-leds";
        red_led: led_2 {
            gpios = <&gpiob 14 GPIO_ACTIVE_HIGH>;
        };
    };

    aliases {
        led2 = &red_led;
    };
};

/* Phase 3: FDCAN1 at 500 kbps — PD0 (RX), PD1 (TX)
 * Connect to TCAN1042 or SN65HVD230 (3.3 V) transceiver.
 * In loopback mode (CONFIG_HDV_CAN_LOOPBACK=y) no transceiver is needed.
 * Pinctrl nodes defined in Zephyr's stm32h7-pinctrl.dtsi. */
&fdcan1 {
    status = "okay";
    pinctrl-0 = <&fdcan1_rx_pd0 &fdcan1_tx_pd1>;
    pinctrl-names = "default";
    bitrate = <500000>;
    sample-point = <875>;
};

&usart3 {
    status = "okay";
    current-speed = <115200>;
};

/* Static MAC address — locally administered, unicast (safe on any network) */
&mac {
    status = "okay";
    local-mac-address = [02 00 5E 00 53 01];
};

&iwdg {
    status = "okay";
};

/* ── Flash partition layout — overrides board DTS defaults ───────────────────
 * STM32H753ZI: 2 MB dual-bank flash, 128 KB sectors.
 * ALL boundaries must be 128 KB aligned.
 *
 * Board default (nucleo_h753zi.dts):
 *   0x08000000  MCUboot    128 KB  sector 0, bank 1
 *   0x08020000  Storage    128 KB  sector 1, bank 1  ← left in place (board default)
 *   0x08040000  Slot 0     256 KB  sectors 2-3, bank 1 (default — too small for us)
 *   0x08080000  Slot 1     256 KB  sectors 4-5, bank 1 (default)
 *   0x080C0000  Scratch    128 KB  sector 6, bank 1  (default)
 *
 * Our override (expand slots, respect storage_partition at 0x20000):
 *   0x08000000  MCUboot    128 KB  (sector 0, bank 1)
 *   0x08020000  Storage    128 KB  (sector 1, bank 1)  — board default, not touched
 *   0x08040000  Slot 0     640 KB  (sectors 2-6, bank 1)  ← active app
 *   0x080E0000  Unused     128 KB  (sector 7, bank 1)
 *   0x08100000  Slot 1     640 KB  (sectors 0-4, bank 2)  ← OTA update
 *   0x081A0000  Unused     256 KB  (sectors 5-6, bank 2)
 *   0x081E0000  Scratch    128 KB  (sector 7, bank 2)
 *
 * slot0 node stays at partition@40000 — matches board DTS node name, no warnings.
 * 640 KB >> 286 KB app; ample headroom.
 */
&boot_partition {
    reg = <0x00000000 DT_SIZE_K(128)>;
};
&slot0_partition {
    reg = <0x00040000 DT_SIZE_K(640)>;
};
&slot1_partition {
    reg = <0x00100000 DT_SIZE_K(640)>;
};
&scratch_partition {
    reg = <0x001E0000 DT_SIZE_K(128)>;
};
